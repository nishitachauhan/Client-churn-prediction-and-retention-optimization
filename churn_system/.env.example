# Copy to .env (same folder as docker-compose.yml) if you want to change these.
# All values are optional.

# Require an API key on every endpoint when set. Leave empty for the default
# local demo setup.
CHURN_API_KEY=

# Allowed browser origins for the backend (comma separated).
CHURN_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
